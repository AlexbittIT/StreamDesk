# Caddy — reverse-proxy с автоматическим HTTPS перед StreamDesk.
# У Java-бэкенда своего TLS нет, поэтому HTTPS терминируется здесь.
#
# Домен берётся из переменной SITE_DOMAIN (задаётся в .env, пробрасывается
# docker-compose в контейнер caddy):
#   - реальный домен (например app.example.ru) -> Caddy сам возьмёт сертификат
#     Let's Encrypt (нужны открытые порты 80/443 и DNS, указывающий на сервер);
#   - localhost (по умолчанию) -> Caddy выдаёт self-signed сертификат своего
#     внутреннего CA, чтобы стек поднимался и локально по HTTPS.
#
# Чтобы получать уведомления Let's Encrypt об истечении сертификата, добавь
# свой e-mail глобальным блоком (Caddy работает и без него):
#   {
#       email admin@example.ru
#   }
#
# ВАЖНО (streamdesk.ru): перед сервером стоит внешний edge/WAF-прокси
# провайдера (виден как "Server: Angie"), который сам терминирует TLS для
# браузеров и форвардит запросы на origin по обычному HTTP. ACME-провалидация
# Let's Encrypt (TLS-ALPN-01 и HTTP-01) до этого Caddy не доходит — WAF её
# либо блокирует (tls-alpn: "Network unreachable"), либо отвечает своим 404
# на /.well-known/acme-challenge/. Поэтому здесь схема жёстко "http://":
# Caddy НЕ пытается получить сертификат сам, а просто отдаёт HTTP, доверяя
# TLS внешнему прокси. Если когда-нибудь домен уйдёт с этого edge/WAF
# напрямую на сервер — верни автоматический HTTPS, убрав "http://".

http://{$SITE_DOMAIN:localhost} {
	encode gzip
	# Единственный апстрим: приложение отдаёт и SPA, и /api на порту 5050
	# по внутренней docker-сети (хост = имя сервиса "app").
	reverse_proxy app:5050
}
