# База данных PostgreSQL
# Для локальной разработки замените на ваш URL подключения к PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/streamstudio

# Настройки базы данных (автоматически извлекаются из DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=username
PGPASSWORD=password
PGDATABASE=streamstudio

# Секретный ключ для сессий (создайте свой случайный ключ)
SESSION_SECRET=your-super-secret-session-key-here-change-this

# Настройки сервера
PORT=5000
NODE_ENV=development

# Настройки для Replit (не нужны для локальной разработки)
# REPL_ID=your-repl-id
# REPLIT_DOMAINS=your-domain.replit.dev

# Внешние API ключи (опционально)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# YOUTUBE_API_KEY=your-youtube-api-key
# VK_API_TOKEN=your-vk-api-token