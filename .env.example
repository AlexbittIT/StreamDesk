# База данных PostgreSQL
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Спецсимволы в пароле (@, :, # и т.д.) закодируйте в URL (например %40 для @)
# Пример: postgresql://postgres:mypass@localhost:5432/streamdesk
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Порт сервера
PORT=5000

# Режим (development | production)
NODE_ENV=development

# Секрет для подписи сессий (обязательно в production, длинная случайная строка)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# --- Деплой на сервер (для npm run deploy) ---
# Заполните один раз — скрипт будет подключаться без вопросов
# SERVER_USER=ваш_пользователь
# SERVER_IP=194.58.112.174
# SERVER_PATH=/var/www/streamdesk

# В production обязательно: отключить fallback-админа и задать SESSION_SECRET
# ALLOW_FALLBACK_ADMIN=false

# --- HTTPS (чтобы логин и пароль нельзя было увидеть в Wireshark / перехватить) ---
# В production используйте HTTPS: либо задайте пути к сертификату и ключу, либо поднимите приложение за nginx/caddy с SSL.
# Пути к файлам (PEM) или оставьте пусто для HTTP (логин по HTTP в production будет запрещён).
# SSL_CERT_PATH=./certs/fullchain.pem
# SSL_KEY_PATH=./certs/privkey.pem

# --- YouGile (таск-менеджер) ---
# Ключ API: Настройки YouGile → получить ключ (https://ru.yougile.com/api-v2#/).
# Без ключа таск-менеджер работает только локально.
# YOUGILE_API_KEY=
# Базовый URL API YouGile (по умолчанию https://yougile.com/api-v2)
# YOUGILE_BASE_URL=https://yougile.com/api-v2

# --- YouGile (двусторонняя синхронизация задач) ---
# ID компании YouGile (получить в YouGile или через API /companies по логину и паролю)
# YOUGILE_COMPANY_ID=
# Ключ API: задать вручную ИЛИ один раз получить в Настройках (логин + пароль YouGile). Лимит 50 запросов/мин.
# YOUGILE_API_KEY=
# Опционально: базовый URL (по умолчанию https://yougile.com/api-v2)
# YOUGILE_BASE_URL=https://yougile.com/api-v2
# ID колонки YouGile, в которую создавать новые задачи из CRM (из раздела Доски → Колонки)
# YOUGILE_DEFAULT_COLUMN_ID=

# --- Клиент (пересоберите после изменения: npm run build) ---
# Базовый URL API, если фронт и бэк на разных доменах (иначе оставьте пустым)
# VITE_API_BASE=
