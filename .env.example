# ============================================================
# StreamDesk — пример переменных окружения (Java-бэкенд).
# Скопируй в .env и заполни. Закомментированные строки — опциональны.
# ============================================================

# --- PostgreSQL (запуск через docker compose) ---
# Использует контейнер БД и docker-compose.yml. Хост для приложения compose
# подставляет сам (db). На проде ОБЯЗАТЕЛЬНО смени POSTGRES_PASSWORD на сильный.
POSTGRES_DB=streamdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- PostgreSQL (локальный запуск БЕЗ Docker) ---
# Java читает JDBC-URL (формат отличается от postgresql://...).
# При запуске через Docker не нужен — compose подставляет хост db.
# JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/streamdesk

# --- Порт бэкенда ---
# Java-бэкенд слушает SERVER_PORT (по умолчанию 5050).
SERVER_PORT=5050

# --- Схема БД (Hibernate ddl-auto) ---
# По умолчанию validate — Hibernate НЕ меняет существующую схему.
# На свежей/пустой БД задай один раз update (создаст таблицы из сущностей),
# затем убери переменную — вернётся безопасный validate.
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Аутентификация / админ ---
# Fallback-админ (виртуальный вход, не в БД). На проде держи false.
# Для первого входа на свежую БД можно временно поставить true.
ALLOW_FALLBACK_ADMIN=false
# Логин/пароль fallback-админа (действуют ТОЛЬКО при ALLOW_FALLBACK_ADMIN=true).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123

# --- Сессия / безопасность куки ---
# Secure-флаг session-куки: true ТОЛЬКО за HTTPS (иначе браузер не сохранит её по HTTP).
SESSION_COOKIE_SECURE=false

# --- HTTPS / reverse-proxy (Caddy) ---
# Своего TLS у Java-бэкенда нет — HTTPS терминирует сервис caddy (см. Caddyfile).
# SITE_DOMAIN: реальный домен -> авто-сертификат Let's Encrypt (нужны DNS на сервер
# и открытые порты 80/443). localhost (по умолчанию) -> self-signed для локали.
# На проде: SITE_DOMAIN=app.example.ru, SESSION_COOKIE_SECURE=true,
#           CORS_ALLOWED_ORIGINS=https://app.example.ru
SITE_DOMAIN=localhost
# Для уведомлений Let's Encrypt об истечении сертификата добавь свой e-mail
# глобальным блоком в Caddyfile (см. комментарий в самом файле).

# --- CORS ---
# Домены, которым разрешены запросы с куками (через запятую). На проде — свой домен.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:3000

# --- Сетевой принтер этикеток TSC/TSPL ---
# Из утилиты принтера: RAW-печать через порт 9100.
LABEL_PRINTER_HOST=10.90.109.120
LABEL_PRINTER_PORT=9100
LABEL_PRINTER_DPI=300
LABEL_WIDTH_MM=40
LABEL_HEIGHT_MM=20
LABEL_GAP_MM=2

# --- Клиент (Vite, сборка фронта) ---
# Базовый URL API, если фронт и бэк на разных доменах. Иначе оставь пустым.
# Пересобери фронт после изменения: npm run build.
# VITE_API_BASE=

# --- YouGile: таск-менеджер ---
# Ключ API: настройки YouGile -> получить ключ. Без ключа синк работает локально.
# YOUGILE_API_KEY=
# YOUGILE_BASE_URL=https://ru.yougile.com/api-v2
# YOUGILE_COMPANY_ID=
# YOUGILE_DEFAULT_COLUMN_ID=

# --- AI для схем подключения (DeepSeek / HuggingFace) ---
# Без ключей стек поднимется, но AI-эндпоинты вернут 503.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# openai — стандартный DeepSeek; anthropic — шлюз OpenModel (/messages)
# DEEPSEEK_PROTOCOL=openai
# HUGGINGFACE_API_KEY=
# HF_TOKEN=

# ============================================================
# === MediaMTX (медиасервер для вкладки «MediaMTX») ==========
# ============================================================
# Бэкенд (Java) управляет MediaMTX через Control API и строит URL потоков
# (SRT/RTMP/RTSP вход -> HLS/WebRTC просмотр). Без запущенного MediaMTX вкладка
# покажет «MediaMTX offline», а /api/mediamtx/* ответит 503.
# MEDIAMTX_API_URL — адрес Control API (apiAddress в mediamtx.yml, обычно :9997).
# MEDIAMTX_HOST    — публичный хост, по которому браузер/vMix подключаются к потокам.
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_HOST=localhost
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_RTSP_PORT=8554
# http или https (если перед MediaMTX стоит TLS-прокси)
MEDIAMTX_HLS_SCHEME=http
